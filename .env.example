# --- App ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_NAME="Clothing Brand"
# Primary frontend URL (CORS + links inside emails)
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated (e.g. a Vercel preview domain)
CORS_EXTRA_ORIGINS=
# Number of reverse proxies in front of the app (Render/Railway/Nginx = 1)
TRUST_PROXY=0
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
DOCS_ENABLED=true

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/clothing-brand
# Optional locally: without Redis, emails are sent inline instead of queued
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# lax is right when web and API share a site (same parent domain, or the web app proxies /api).
# Use none only for fully cross-site setups (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Email (SMTP). Local default is Mailpit: docker compose up -d, inbox at http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Clothing Brand <no-reply@localhost>"

# --- Seeding (npm run seed) ---
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Media storage (Phase 3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments: PayFast + Cash on Delivery, PKR (Phase 6) ---
CURRENCY=PKR
